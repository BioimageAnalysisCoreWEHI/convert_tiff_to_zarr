manifest {
    name            = 'convert_tiff_to_zarr'
    description     = 'Convert large multi-channel TIFF images to OME-Zarr using ngff-zarr'
    author          = 'WEHI SODA Hub'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
}

// ---------------------------------------------------------------------------
// Default process settings (local execution)
// ---------------------------------------------------------------------------
process {
    executor      = 'local'
    cpus          = 4
    memory        = '32 GB'
    time          = '12h'
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_medium' {
        cpus   = 4
        memory = '32 GB'
        time   = '12h'
    }
}

docker.enabled      = false
singularity.enabled = false
conda.enabled       = false

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    // --- Environment profiles (combine with an HPC profile below) ----------

    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
        process.conda       = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled      = true
        conda.enabled       = false
        singularity.enabled = false
        // Build the image first: docker build -t ngff-zarr:latest .
        process.container   = 'ngff-zarr:latest'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
        // Build from Dockerfile: singularity build ngff-zarr.sif docker-daemon://ngff-zarr:latest
        process.container      = "${projectDir}/ngff-zarr.sif"
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        process.container    = "${projectDir}/ngff-zarr.sif"
    }

    // --- HPC / SLURM profiles ---------------------------------------------
    // Combine with an environment profile, e.g.:
    //   nextflow run main.nf -profile small,conda --input '...' --outdir results

    small {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_medium' {
                cpus          = { 4 * task.attempt }
                memory        = { 64.GB * task.attempt }
                time          = { 12.h * task.attempt }
                errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
                maxRetries    = 2
            }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    medium {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_medium' {
                cpus          = { 8 * task.attempt }
                memory        = { 128.GB * task.attempt }
                time          = { 24.h * task.attempt }
                errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
                maxRetries    = 2
            }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    large {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_medium' {
                cpus          = { 16 * task.attempt }
                memory        = { 380.GB * task.attempt }
                time          = { 48.h * task.attempt }
                errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
                maxRetries    = 2
            }
        }
        executor {
            queueSize       = 20
            submitRateLimit = '5/1min'
        }
    }
}

// ---------------------------------------------------------------------------
// Seqera Platform (tower.io)
// When launched from Seqera Platform the token is injected automatically.
// For manual CLI runs: export TOWER_ACCESS_TOKEN=<your token>
// ---------------------------------------------------------------------------
tower {
    accessToken = System.env.TOWER_ACCESS_TOKEN ?: ''
    enabled     = (System.env.TOWER_ACCESS_TOKEN != null && System.env.TOWER_ACCESS_TOKEN != '')
}
